# Salin ke .env lalu sesuaikan. Nilai di environment menang atas isi file ini.
ADDR=:8080
DATABASE_URL=postgres://antay:antay@127.0.0.1:5432/antay?sslmode=disable

# Umur sesi login. Standar produksi 15m; untuk demo lokal 8h lebih nyaman.
SESSION_TTL=8h
COOKIE_SECURE=false
AUTO_MIGRATE=true
APP_VERSION=dev

# Kosongkan untuk memakai kunci RSA yang dibangkitkan saat start (token hilang
# setiap restart). Isi untuk produksi, format PKCS1/PKCS8 dalam PEM.
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
